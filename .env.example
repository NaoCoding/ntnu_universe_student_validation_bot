# Discord
DISCORD_TOKEN=replace-with-discord-bot-token
VERIFICATION_CHANNEL_ID=000000000000000000
ADMIN_CHANNEL_ID=000000000000000000

# Gmail API OAuth files. Keep credentials.json and token.json out of git.
GMAIL_CREDENTIALS_FILE=credentials.json
GMAIL_TOKEN_FILE=token.json
GMAIL_SENDER_EMAIL=your-account@gapps.ntnu.edu.tw

# MD5(CONCAT(user_email,
#           CONCAT(VERIFICATION_HASH_SECRET_PART_1,
#                 VERIFICATION_HASH_SECRET_PART_2)))
# Put the real values only in .env.
VERIFICATION_HASH_SECRET_PART_1=replace-me
VERIFICATION_HASH_SECRET_PART_2=replace-me

# JSON object: student number (XXX47XXX) -> Discord role name or role ID.
# Example: {"12347001":"資工系學生","12347002":"資工系學生二年級"}
STUDENT_ROLE_MAP_JSON={}
# JSON object: student-number prefix -> Discord role name or role ID.
# "41247" matches every 41247XXX student number.
STUDENT_ROLE_PREFIX_MAP_JSON={"41247":"資工系學生"}
# This role is additive: matching users receive it along with exact/prefix roles.
DEFAULT_STUDENT_ROLE=
VERIFICATION_CODE_TTL_MINUTES=10
# Do not send another code to the same email address during this interval.
EMAIL_SEND_RATE_LIMIT_SECONDS=60
# A student number that passed email verification cannot pass it again during this interval.
STUDENT_REVERIFICATION_COOLDOWN_DAYS=30
DATABASE_FILE=verification.db
